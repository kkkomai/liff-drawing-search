# ============================================================================
# Bento Order API — 環境変数設定例
#
# 使い方: cp .env.example .env して値を書く。.env は gitignore 済み。
#
# 「機密」と「非機密」を分けて書くこと:
#   ・非機密 … LIFF ID, API URL, DB パス, 環境名, CORS Origins
#              → フロントの env.<環境>.js にも同じ値が入る
#   ・機密   … BENTO_LINE_CHANNEL_SECRET, BENTO_LINE_CHANNEL_ACCESS_TOKEN,
#              BENTO_DEV_AUTH_TOKEN
#              → フロントには絶対に持ち込まない。ログにも出さない。
# ============================================================================

# --- deployment identity ---------------------------------------------------
# dev / staging / prod。prod のときは起動時に本番チェックが走り、
# 機密設定の抜けがあれば起動を拒否する（未完了のまま本番を動かさない）。
BENTO_APP_ENV=dev

# このバックエンドの公開ベースURL。/api/config がクライアントへ返す値。
# フロントと同一オリジンに置く場合（推奨）は、そのオリジンを書く。
# 本番は https 必須（http だと起動時チェックで拒否される）。
BENTO_PUBLIC_API_BASE_URL=http://localhost:8000

# --- storage ---------------------------------------------------------------
# SQLite file. Parent directories are created automatically.
# 本番は永続化ボリュームを指すこと（一時パスはプロセス再起動で消える）。
BENTO_DATABASE_PATH=data/bento.db

# --- LINE LIFF app identity ------------------------------------------------
# LINE Developers コンソール > Provider > LIFF app から払い出し。
# 申請フォームが返す URL は https://liff.line.me/<BENTO_LIFF_ID>。
# 設定し忘れると申請フォームは 503 で「未設定」と応答する
# （壊れた URL を返すより、そのほうが原因が分かる）。
BENTO_LIFF_ID=

# LIFF アプリURLを直接指定したい場合のみ（通常は BENTO_LIFF_ID だけでよい）。
# 設定されている場合は BENTO_LIFF_ID より優先される。
BENTO_LIFF_APP_URL=

# --- static frontend -------------------------------------------------------
# LIFF のエンドポイントURLに静的ファイルを直接配る場合のみ指定。
# 設定すると API と画面が同じオリジンになり、CORS に依存しない構成になる。
# 例: BENTO_FRONTEND_DIR=../frontend
BENTO_FRONTEND_DIR=

# --- LINE Messaging API（申請フォームのURLを送信する） ---------------------
# コンソールの「Messaging API 設定」から発行した長期トークン。
# 未設定でも起動はできるが、送信 API は 503 で明示的に失敗する
# （「送ったつもり」で終わらせない）。
BENTO_LINE_CHANNEL_ACCESS_TOKEN=

# --- LINE LIFF / ID token verification (REQUIRED in production) -------------
# From LINE Developers console > your provider > LIFF app.
# Leave BOTH empty only for local development together with BENTO_DEV_AUTH_TOKEN;
# with neither set, POST /api/auth/login always fails closed with 401/503.
BENTO_LINE_CHANNEL_ID=
BENTO_LINE_CHANNEL_SECRET=

# --- sessions --------------------------------------------------------------
# Bearer token lifetime in hours (default 168 = 7 days).
BENTO_SESSION_TTL_HOURS=168

# --- dev escape hatch ------------------------------------------------------
# Local/staging only. When set, login accepts {"line_user_id","dev_token"}.
# MUST be empty in production — 本番起動時に残っていると起動を拒否する。
BENTO_DEV_AUTH_TOKEN=

# --- CORS ------------------------------------------------------------------
# 追加許可オリジンのカンマ区切り。https://liff.line.me は常時許可される
# （すべての LIFF アプリがそのオリジンで配信されるため）ので、このリストは
# dev/staging のホスト名用。本番で '*' を指定すると起動を拒否する。
BENTO_CORS_ORIGINS=http://localhost:8765